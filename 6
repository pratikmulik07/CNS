import hashlib

original_message = "Hello World"
modified_message = "Hello world"

hash1 = hashlib.sha1(original_message.encode()).hexdigest()
hash2 = hashlib.sha1(modified_message.encode()).hexdigest()

print("Original Message:", original_message)
print("SHA1 Hash:", hash1)

print("Modified Message:", modified_message)
print("SHA1 Hash:", hash2)

if hash1 == hash2:
    print("Hashes are same")
else:
    print("Hashes are different")
    print("Avalanche effect demonstrated")
